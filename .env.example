# Adresse de la machine sur le réseau local.
RELAY_IP=
# Zone dont tous les noms mènent ici (résolveur relay-dns).
RELAY_ZONE=home.arpa
# Jeton du Hub (laisser vide sans Hub).
RELAY_HUB_TOKEN=
# Contact Let's Encrypt (mode public).
ACME_EMAIL=
# Comptes : SOCLE_HTTP=1 tant que l'interface n'est pas servie en HTTPS.
SOCLE_HTTP=0
